{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install *)",
      "Bash(pnpm test *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm build *)",
      "Bash(pnpm format *)",
      "Bash(pnpm vitest *)",
      "Bash(pnpm dev *)",
      "Bash(npx tsc *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(python -m venv *)",
      "Bash(pip install *)",
      "Bash(uvicorn *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git stash list *)",
      "Bash(curl -s http://localhost:*)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)"
    ]
  }
}
